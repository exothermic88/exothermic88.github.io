---
import { getCollection } from 'astro:content';
import { getLatestRelease } from '../lib/release';

const release = await getLatestRelease();
const released = release.date
  ? release.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
  : '—';

const [announcement] = (await getCollection('news', (post) => post.data.tag === 'release')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<div class="release mono">
  <div class="row">
    <span class="k">version</span>
    <span class="v">{release.version}</span>
  </div>
  <div class="row">
    <span class="k">released</span>
    <span class="v">{released}</span>
  </div>
  <div class="row">
    <span class="k">arch</span>
    <span class="v">x86_64</span>
  </div>
  {
    announcement && (
      <div class="changelog">
        <p class="k">latest changes</p>
        <p class="title">{announcement.data.title}</p>
        <p class="summary">{announcement.data.summary}</p>
        <div class="links">
          <a href={`/news/${announcement.id}/`}>Read announcement →</a>
          <a href="/wiki/release-notes/">Release notes →</a>
        </div>
      </div>
    )
  }
</div>

<style>
  .release {
    display: grid;
    gap: 0.4rem;
    font-size: 0.88rem;
  }

  .row {
    display: flex;
    gap: 1rem;
  }

  .k {
    color: var(--muted);
    min-width: 90px;
  }

  .k::after {
    content: ':';
  }

  .v {
    color: var(--teal);
  }

  .changelog {
    margin-top: 1rem;
    border-top: 1px dashed var(--border);
    padding-top: 1rem;
  }

  .changelog .title {
    color: var(--text);
    font-size: 0.88rem;
    margin: 0.5rem 0 0.4rem;
  }

  .changelog .summary {
    color: var(--muted);
    font-size: 0.82rem;
    font-family: inherit;
    margin-bottom: 0.75rem;
  }

  .changelog .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .changelog a {
    font-size: 0.82rem;
  }
</style>
